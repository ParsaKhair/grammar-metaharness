# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# The mock backend needs none of these.

# --- Pi (OpenAI-compatible / llama.cpp / vLLM endpoint, native GBNF) ---
PI_BASE_URL=http://localhost:8080
PI_API_KEY=
PI_MODEL=pi

# --- Claude Code CLI (optional: override binary location) ---
CLAUDE_CODE_BIN=claude

# --- Codex CLI (optional: override binary location) ---
CODEX_BIN=codex

# --- Optional: point the tool at a non-default config ---
# GRAMMAR_METAHARNESS_CONFIG=/absolute/path/to/config.toml
